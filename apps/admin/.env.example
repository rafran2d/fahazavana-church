# URL de l'API vue par le navigateur. Par défaut : /api/v1 (relayé par Vite en dev).
# En production : https://api.example.mg/api/v1
VITE_API_URL=/api/v1
# Cible du proxy de développement
VITE_API_PROXY=http://localhost:3000
# Adresse affichée sur la page Abonnement du Church Admin (bouton masqué si vide)
VITE_SUPPORT_EMAIL=
