# ---------- Général ----------
NODE_ENV=development
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000/api/v1

# ---------- PostgreSQL ----------
POSTGRES_DB=fahazavana
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@postgres:5432/fahazavana?schema=public

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---------- Auth ----------
# Au moins 32 caractères aléatoires en production
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Secret partagé API <-> worker IA pour les routes internes
INTERNAL_API_TOKEN=change-me-internal-token-at-least-32-chars

# ---------- Stockage S3 (MinIO en local) ----------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fahazavana
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_FORCE_PATH_STYLE=true

# ---------- LiveKit ----------
LIVEKIT_API_KEY=devkey
# Au moins 32 caractères, identique à infra/livekit/*.yaml
LIVEKIT_API_SECRET=devsecret-change-me-at-least-32-characters
# URL interne (API, worker, egress)
LIVEKIT_URL=http://livekit:7880
LIVEKIT_WS_URL=ws://livekit:7880
# URL donnée aux téléphones
LIVEKIT_PUBLIC_WS_URL=ws://localhost:7880
# IP LAN de la machine hôte (téléphones sur le même réseau)
LIVEKIT_NODE_IP=127.0.0.1

# ---------- Firebase (optionnel en dev : notifications loguées si vide) ----------
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------- Langues ----------
DEFAULT_SOURCE_LANGUAGE=fr
DEFAULT_TARGET_LANGUAGES=en,mg

# ---------- Worker IA ----------
API_INTERNAL_URL=http://api:3000/api/v1
STT_PROVIDER=faster_whisper
# small en dev CPU ; medium/large-v3 sur GPU pour la passe finale
STT_LIVE_MODEL=small
STT_FINAL_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# dummy = préfixe la langue (dev sans modèle) ; nllb = NLLB-200 via CTranslate2
TRANSLATION_PROVIDER=dummy
NLLB_MODEL_DIR=/models/nllb-200-distilled-600M-ct2
SEGMENT_MAX_SECONDS=15
